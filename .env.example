# The public address of the site, read at build time. Its domain picks the brand in lib/brand.ts:
# https://saydeed.com builds the Saydeed site; anything else (or nothing) builds Devista AI.
NEXT_PUBLIC_SITE_URL=

# Google Calendar booking for /book. Server only: never prefix these with NEXT_PUBLIC_.
# Without them, `next dev` uses a built-in mock calendar, and a production build refuses to
# book and tells the visitor that booking is unavailable.
#
# OAuth client from Google Cloud (type: Web application) and a refresh token for the host's
# Google account, granted the calendar.events and calendar.freebusy scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The calendar that receives bookings. "primary" is the host account's main calendar.
GOOGLE_CALENDAR_ID=primary
