# The public address of the site, read at build time. It sets canonical links, the sitemap and
# social image addresses. Leave it empty to use the default, https://saydeed.com.
NEXT_PUBLIC_SITE_URL=

# Google Calendar booking for /book. Server only: never prefix these with NEXT_PUBLIC_.
# Without them, `next dev` uses a built-in mock calendar, and a production build refuses to
# book and tells the visitor that booking is unavailable.
#
# 1. In Google Cloud, create an OAuth client (type: Desktop app) and copy its ID and secret here.
# 2. Run `npm run booking:auth -- --write`, sign in as the account whose calendar takes the
#    bookings, and the refresh token is filled in for you. Full steps: deploy/README.md, "Booking".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The calendar that receives bookings. "primary" is the host account's main calendar.
GOOGLE_CALENDAR_ID=primary
# Google sends each invite from the account behind GOOGLE_REFRESH_TOKEN. Every booking also invites
# CONTACT.email (lib/site.ts), so it reaches that inbox. For invites that come from that address,
# sign in as it when you run booking:auth (deploy/README.md, "Which address bookings come from").
